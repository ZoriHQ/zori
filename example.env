# Database Configuration
POSTGRES_URL=postgres://user:password@localhost:5432/zori_db?sslmode=disable
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default

# Redis Configuration
REDIS_ADDRS=localhost:6379
REDIS_PASSWORD=

# NATS Configuration
NATS_STREAM_URL=nats://localhost:4222
NATS_CREDENTIALS_CONTENT=

# Clerk Auth Configuration (for Cloud version)
# Get your secret key from: https://dashboard.clerk.com/
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Encryption Configuration (for payment provider credentials)
ENCRYPTION_KEY=your-32-char-encryption-key-here

# API Host Configuration
ZORI_API_HOST=http://localhost:1323

# OSS Mode Configuration
ZORI_IS_OSS=false

# Stripe Apps Configuration (for Cloud version)
# Set ZORI_STRIPE_APP=true to enable Stripe App OAuth flow
# When enabled, users must install the Stripe App via OAuth instead of manual API key entry
# Get the installation link from your Stripe App settings (it includes a unique chnlink_* token)
# Example: https://marketplace.stripe.com/oauth/v2/chnlink_xxxxx/authorize?client_id=ca_xxxxx&redirect_uri=https://...
# Note: Only live mode is supported for production revenue analytics
ZORI_STRIPE_APP=true
ZORI_STRIPE_APP_INSTALL_LINK=
ZORI_STRIPE_APP_SECRET_KEY=
ZORI_STRIPE_APP_WEBHOOK_SECRET=

# Debug Configuration
BUNDEBUG=1

# Metrics & Observability Configuration (Grafana Cloud)
# Set METRICS_ENABLED=true to enable Prometheus metrics collection
METRICS_ENABLED=false
METRICS_PORT=9090

# Grafana Cloud Configuration (optional - for remote write)
# Get these from: https://grafana.com/orgs/YOUR_ORG/stacks
# Navigate to: Prometheus -> Details -> Remote Write
GRAFANA_CLOUD_REMOTE_WRITE_URL=https://prometheus-prod-XX-prod-us-central-0.grafana.net/api/prom/push
GRAFANA_CLOUD_USERNAME=
GRAFANA_CLOUD_API_KEY=
